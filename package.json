{
  "name": "plant-nursery-mern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch backend/server.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build && node backend/scripts/build-assets.js",
    "start": "node backend/server.js",
    "seed": "node backend/scripts/seed.js",
    "seed:admin": "node backend/scripts/seed-admin.js",
    "import:mysql": "node backend/scripts/import-mysql.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.14",
    "mysql2": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}